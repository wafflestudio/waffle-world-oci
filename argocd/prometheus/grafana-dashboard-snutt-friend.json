    {
      "type": "timeseries",
      "id": 8,
      "title": "친구 요청",
      "description": "날짜별로 보낸 친구 요청을 지금 상태로 나눴어요. 링크로 바로 맺은 친구도 '수락됨'에 들어가요. 거절했거나 나중에 끊은 관계는 빠져요.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 0,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT TIMESTAMP(date, 'Asia/Seoul') AS time, accepted AS `수락됨`, pending AS `대기 중`\nFROM `snutt-792f1.snutt_metrics.friend_daily` WHERE date BETWEEN DATE($__timeFrom(), 'Asia/Seoul') AND DATE($__timeTo(), 'Asia/Seoul') ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "친구 화면을 본 기기 (iOS)",
      "description": "그날 친구 화면을 한 번 이상 연 iOS 기기 수와, 그날 iOS DAU 중 비율(오른쪽 축).",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 0,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT TIMESTAMP(date, 'Asia/Seoul') AS time, friends_viewers AS `친구 화면을 본 기기`,\n  SAFE_DIVIDE(friends_viewers, dau) AS `iOS DAU 중 비율`\nFROM `snutt-792f1.snutt_metrics.ga_daily` WHERE date BETWEEN DATE($__timeFrom(), 'Asia/Seoul') AND DATE($__timeTo(), 'Asia/Seoul') AND platform = 'IOS' ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "iOS DAU 중 비율"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
