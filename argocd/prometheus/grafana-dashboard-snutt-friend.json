      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT pending_requests AS `대기` FROM `snutt-792f1.snutt_metrics.friend_summary`"
