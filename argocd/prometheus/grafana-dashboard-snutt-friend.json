    {
      "type": "stat",
      "id": 6,
      "title": "최근 7일 친구 요청",
      "description": "최근 7일 동안 보낸 친구 요청 수. 거절된 요청은 빠져요.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT SUM(requests) AS `요청` FROM `snutt-792f1.snutt_metrics.friend_daily`\nWHERE date > DATE_SUB((SELECT MAX(date) FROM `snutt-792f1.snutt_metrics.server_daily`), INTERVAL 7 DAY)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
