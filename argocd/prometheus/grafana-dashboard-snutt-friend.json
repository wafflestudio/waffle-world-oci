    {
      "type": "stat",
      "id": 3,
      "title": "친구 관계",
      "description": "지금 맺어져 있는 친구 관계 수. 한 쌍을 1로 셉니다.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT friendships AS `수락된 친구 관계` FROM `snutt-792f1.snutt_metrics.friend_summary`"
        }
      ],
      "fieldConfig": {
        "defaults": {
