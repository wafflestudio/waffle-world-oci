      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "친구가 있는 사용자",
      "description": "친구가 한 명 이상 있는 사용자 수와, 탈퇴하지 않은 전체 가입자 중 비율.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT users_with_friend AS `사용자`, SAFE_DIVIDE(users_with_friend, active_users) AS `전체 가입자 중`\nFROM `snutt-792f1.snutt_metrics.friend_summary`"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
