          "format": 1,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT bucket AS `친구 수`, users AS `사용자` FROM `snutt-792f1.snutt_metrics.friend_count_dist` WHERE bucket_order > 0 ORDER BY bucket_order"
