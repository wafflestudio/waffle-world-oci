    {
      "type": "timeseries",
      "id": 3,
      "title": "강의평 작성 · 좋아요",
      "description": "날짜별 수. 지금도 남아 있는 강의평 기준이고, 옛 SNUEV에서 옮겨 온 강의평은 빠져요.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 0,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT TIMESTAMP(date, 'Asia/Seoul') AS time, evaluations AS `강의평 작성`, evaluation_likes AS `좋아요`\nFROM `snutt-792f1.snutt_metrics.server_daily` WHERE date BETWEEN DATE($__timeFrom(), 'Asia/Seoul') AND DATE($__timeTo(), 'Asia/Seoul') ORDER BY time"
        }
      ],
      "fieldConfig": {
