    {
      "type": "stat",
      "id": 2,
      "title": "최근 7일 강의평",
      "description": "새로 작성된 강의평 수. 지금도 남아 있는 강의평 기준.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT SUM(evaluations) AS `작성` FROM `snutt-792f1.snutt_metrics.server_daily`\nWHERE date > DATE_SUB((SELECT MAX(date) FROM `snutt-792f1.snutt_metrics.server_daily`), INTERVAL 7 DAY)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
