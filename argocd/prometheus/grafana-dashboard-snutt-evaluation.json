    {
      "type": "barchart",
      "id": 4,
      "title": "학기별 강의평 수",
      "description": "강의를 들은 학기 기준. 옛 SNUEV에서 옮겨 온 강의평은 빠져요.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "snutt-bigquery"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "snutt-bigquery"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT label AS `학기`, evaluations AS `강의평`, evaluation_authors AS `작성자`\nFROM `snutt-792f1.snutt_metrics.semester_stats` WHERE evaluations > 0 ORDER BY year DESC, semester DESC LIMIT 12"
        }
