          "location": "US",
          "project": "snutt-792f1",
          "rawSql": "SELECT TIMESTAMP(DATE_TRUNC(install_date, WEEK(MONDAY)), 'Asia/Seoul') AS time,\n  SAFE_DIVIDE(SUM(d1 * installs), SUM(IF(d1 IS NULL, NULL, installs))) AS D1,\n  SAFE_DIVIDE(SUM(d7 * installs), SUM(IF(d7 IS NULL, NULL, installs))) AS D7,\n  SAFE_DIVIDE(SUM(d30 * installs), SUM(IF(d30 IS NULL, NULL, installs))) AS D30\nFROM `snutt-792f1.snutt_metrics.ga_retention_daily` WHERE install_date BETWEEN DATE($__timeFrom(), 'Asia/Seoul') AND DATE($__timeTo(), 'Asia/Seoul')\nGROUP BY time ORDER BY time"
